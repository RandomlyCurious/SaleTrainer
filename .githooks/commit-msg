#!/bin/sh
# Impose les Conventional Commits sur la première ligne du message
subject=$(head -n 1 "$1")

if ! echo "$subject" | grep -qE '^(feat|fix|refactor|test|chore|docs)(\(.+\))?: .+'; then
  echo "❌ message de commit non conforme : $subject"
  echo "   Format attendu : <type>(<scope optionnel>): <description>"
  echo "   Types autorisés : feat, fix, refactor, test, chore, docs"
  echo "   Exemple : feat(auth): ajoute la connexion magic link (fixes #12)"
  exit 1
fi
