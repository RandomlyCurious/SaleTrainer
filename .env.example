# Copier en .env.local (jamais commité) et renseigner les valeurs.
# Valeurs volontairement vides : le scanner de secrets refuse toute clé en
# clair dans le dépôt.

# --- Supabase (tableau de bord > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVICE_ROLE uniquement côté serveur / CI, JAMAIS NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# Reste côté serveur. La session Realtime passe par un jeton éphémère (#12) :
# cette valeur ne doit jamais atteindre le navigateur.
OPENAI_API_KEY=

# Modèle texte (persona + debrief). Vide = gpt-5-nano, le moins cher du
# catalogue. À surcharger si la passation manuelle (#16) le juge insuffisant.
OPENAI_TEXT_MODEL=
